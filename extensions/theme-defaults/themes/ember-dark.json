	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#6A7482",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#FF7A85"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"support.class.component"
			],
			"settings": {
				"foreground": "#FF7A85"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string punctuation.section.embedded source",
				"source.regexp",
				"string.regexp"
			],
			"settings": {
				"foreground": "#8DD98D"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant",
				"variable.other.constant",
				"variable.other.enummember",
				"variable.language",
				"support.constant"
			],
			"settings": {
				"foreground": "#FF9E64"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic",
				"variable.function"
			],
			"settings": {
				"foreground": "#FFD479"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"entity.name.namespace"
			],
			"settings": {
				"foreground": "#6CC5FF"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.parameter",
				"meta.definition.variable",
				"entity.name"
			],
			"settings": {
				"foreground": "#C3CAD6"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"meta.property-name",
				"support.type.property-name",
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#A5B4C6"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation",
				"meta.brace",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#8892A0"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.broken",
				"invalid.deprecated",
				"invalid.illegal",
				"invalid.unimplemented",
				"message.error"
			],
			"settings": {
				"foreground": "#FF7A85",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#6CC5FF",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#8DD98D"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#C3CAD6",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#C3CAD6",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
